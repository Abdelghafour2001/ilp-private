# Shell scripts and Dockerfiles must reach a Linux image with LF endings.
# Git on Windows checks files out as CRLF by default, and a `#!/usr/bin/env sh`
# followed by \r makes the kernel look for an interpreter literally named "sh\r":
#   env: 'sh\r': No such file or directory
# That is a container that exits 127 on boot with no other explanation.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
