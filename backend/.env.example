# App metadata database (from docker-compose: app-db)
DATABASE_URL=postgresql+psycopg2://dqai:dqai@localhost:5433/dqai

# Celery broker / result backend
REDIS_URL=redis://localhost:6379/0

# Fernet key used to encrypt stored connection credentials.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Anthropic API key for AI features (auto-generate checks, explain failures)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:3000
