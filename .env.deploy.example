# UpSkill — deployment environment (dev / UAT)
# Copy, fill the blanks, hand to DevOps. Full notes: docs/DEPLOY-ENV.md
#
# Applies to the three Python processes: backend, worker, beat.
# The frontend container takes ONE variable, at the bottom of this file.

# ───────────────────────────── branding ──────────────────────────
# What the product is called, in page titles, emails and PDF reports. One
# value: the next client renames it here, not in a branch of the source.
APP_NAME=UpSkill

# ───────────────────────── required: data ─────────────────────────
DATABASE_URL=postgresql+psycopg2://aida:CHANGEME@aida-db:5432/aida
REDIS_URL=redis://aida-redis:6379/0

# Encrypts stored provider credentials at rest.
# Generate: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# MUST be identical on backend, worker and beat. Rotating it invalidates every stored credential.
CREDENTIALS_ENCRYPTION_KEY=

# ──────────────────── required: who may call what ─────────────────
# The single allowed CORS origin — the deployed frontend URL, no trailing slash.
# Wrong value = the UI loads and every API call fails.
FRONTEND_ORIGIN=https://aida-uat.example.com

# Gates the admin and HR APIs. 24+ random characters.
ADMIN_TOKEN=

# Refuses the "nothing configured = open API" fallback. Leave this at 1 on any
# shared environment: the HR payload carries matricules, BUs and job levels.
REQUIRE_ADMIN_AUTH=1

# Email + password sign-in, for people with no Entra account (externals, and
# any environment where SSO is not wired up yet). 1 turns it on; it also needs
# CREDENTIALS_ENCRYPTION_KEY, which is what sessions are signed with.
# Passwords are set by L&D or an admin — there is no self-service reset yet.
PASSWORD_LOGIN=0

# Entra ID SSO. BOTH values must be set, or the app silently falls back to the
# demo handle login with no authentication at all — unless PASSWORD_LOGIN=1,
# which closes the handle login whether or not SSO is configured.
# App registration redirect URI (SPA) = the FRONTEND_ORIGIN above.
# Which doors the login page offers: sso, password, or both. Empty falls back
# to whatever is configured (what PASSWORD_LOGIN alone used to decide).
#   AUTH_METHODS=password       email + password only
#   AUTH_METHODS=sso            Entra only
#   AUTH_METHODS=sso,password   both, on the same deployment
AUTH_METHODS=sso,password
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Set a client secret and the server runs the Entra sign-in itself (redirect
# flow) instead of MSAL in the browser: the app registration is then a plain
# Web app with the redirect URI <FRONTEND_ORIGIN>/api/auth/sso/azure/callback,
# and nothing about the tenant is published to the page. Needs
# CREDENTIALS_ENCRYPTION_KEY, which is what the session is signed with.
AZURE_CLIENT_SECRET=
# Admins, comma-separated, in addition to anyone holding the "admin" App Role.
ADMIN_EMAILS=

# ───────────────────────────── startup ────────────────────────────
# true on the BACKEND only. Set false on worker and beat: three processes
# racing "alembic upgrade head" is how a migration half-applies.
RUN_DB_MIGRATIONS_ON_START=true
# 1 loads demo content after migrating — a fresh dev database only, never UAT.
AUTO_SEED=0
# Each process logs a dependency report (database, Redis, SMTP, AI, SSO) before
# serving. Turns most deployment failures into one readable line.
STARTUP_DIAGNOSTICS_ENABLED=true
# Includes one tiny real AI request in that report to prove the key works.
DIAGNOSTICS_LLM_CALLS=true

# ────────────────────────────── email ─────────────────────────────
# EMPTY SMTP_HOST DISABLES EMAIL SILENTLY — assignments, invites and reminders
# become in-app only. Mailpit on dev, the corporate relay on UAT.
SMTP_HOST=
SMTP_PORT=587
# --- or send through Microsoft Graph instead of SMTP --------------------
# Set all four and mail leaves as this mailbox, through an app registration
# holding the APPLICATION permission Mail.Send (admin-consented). Usually the
# only route available inside the tenant: Exchange Online no longer accepts
# basic authentication, so there is no relay to point SMTP_HOST at.
# Ask the tenant admin to scope the permission with
#   New-ApplicationAccessPolicy -AppId <GRAPH_CLIENT_ID> -PolicyScopeGroupId <mailbox>
# or Mail.Send can send as anybody in the tenant.
# Non-production safety: who this environment may actually email. Comma
# separated addresses, or a domain as @example.com. Empty = everybody, which is
# what production wants. Set it anywhere that holds real people and real mail.
MAIL_ALLOWLIST=

# MICROSOFT_GRAPH_* is accepted for all four, so values copied from an
# existing ATS configuration work unchanged.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
MAIL_FROM=UpSkill <upskill@teal.ma>

# ───────────────────────────── Coursera ───────────────────────────
# off = disabled | mock = fixtures, demos the whole HR pipeline with no contract
# live = the real API, needs the three values below + a Coursera for Business contract
# The public CATALOGUE import needs no credentials and works in any mode.
COURSERA_MODE=off
COURSERA_CLIENT_ID=
COURSERA_CLIENT_SECRET=
COURSERA_ORG_ID=

# ──────────────────────── AI (optional) ───────────────────────────
# Leave LLM_PROVIDER blank to auto-pick: Anthropic if a key is set, else Azure
# OpenAI if configured, else Ollama. With none configured, report commentary
# falls back to computed sentences and nothing else changes.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
# Azure OpenAI path (DEPLOYMENT is a deployment name, not a model id)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Local path
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ─────────────────────── business settings ────────────────────────
# Hours in one man-day for the Jour-Homme figures (7, 7.5 and 8 are all used).
HOURS_PER_MAN_DAY=8
# Days before a certificate expires that the renewal reminder goes out.
# Needs the worker and beat processes running.
CERT_REMINDER_DAYS=60
# Certificates and session decks. MUST BE A PERSISTENT VOLUME — it is the only
# state outside PostgreSQL, and a restart without it loses every upload.
UPLOADS_DIR=uploads
# Contributor-authored lab definitions (*.yaml), read-only.
LABS_DIR=labs

# ═══════════════ FRONTEND CONTAINER — this one only ═══════════════
# Read at runtime by the /api proxy, so one image serves every environment.
# There is no build-time configuration and no NEXT_PUBLIC_* to set.
BACKEND_URL=http://aida-backend:8000
