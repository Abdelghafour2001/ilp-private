# Read automatically by `docker compose` for variable substitution.
# Copy to `.env` and fill in:  cp .env.example .env

# Encrypts stored connection credentials. Generate one with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- LLM: pick ONE. Either a Claude API key, or local Ollama. ---
# Leave LLM_PROVIDER blank to auto-pick: Anthropic if a key is set, else Ollama.
LLM_PROVIDER=

# Option A — Anthropic (best quality). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# Option B — Ollama (local, free). Install from ollama.com, then `ollama pull llama3.1`.
# In Docker, reach the host's Ollama at host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Optional — gate the admin/management API. If blank, admin is open (local dev).
# If set, the admin UI must be given this value (Admin page → Admin token).
ADMIN_TOKEN=

# Refuse the "nothing configured = open API" fallback. Leave blank for local
# dev; set it to 1 in any shared or deployed environment — the HR analytics
# payload carries matricules, BUs and job levels.
REQUIRE_ADMIN_AUTH=

# --- HR reporting ---
# Hours in one man-day, used to report Jour-Homme from learning hours.
HOURS_PER_MAN_DAY=8
# How many days before a certificate expires the renewal reminder goes out.
# The Celery beat schedule runs the sweep daily (services `worker` + `beat`).
CERT_REMINDER_DAYS=60

# NOTE for podman-compose users: unlike `docker compose`, it does not apply the
# default half of a ${VAR:-default} reference when VAR is undefined — it passes
# the literal string through. The backend blanks out such leftovers so they fall
# back to their defaults, but setting the values here explicitly is cleaner.

# --- Coursera ---
# The public CATALOG needs no credentials — importing courses (with real cover
# art and workload) works out of the box via Admin -> Coursera.
#
# Enterprise REPORTING (who enrolled, how far they got) needs a Coursera for
# Business contract with API access; without one the API answers 403.
#   off  = disabled (default)
#   mock = fixtures — demo and test the whole HR pipeline with no contract
#   live = real API (needs the three values below)
COURSERA_MODE=off
COURSERA_CLIENT_ID=
COURSERA_CLIENT_SECRET=
COURSERA_ORG_ID=

# --- Azure Entra ID (Azure AD) SSO. Leave blank to use the simple handle login. ---
# From your App Registration. Redirect URI (SPA): http://localhost:3000
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Admins: assign an "admin" App Role in Azure, and/or list emails here (comma-separated).
ADMIN_EMAILS=

# --- Deployment ---
# The frontend forwards /api to the backend at BACKEND_URL, read at runtime (set it on the
# frontend container, e.g. http://aida-backend:8000). Nothing is fixed at image build time.
# The backend image runs migrations on start; set false on workers or when a Job migrates.
RUN_DB_MIGRATIONS_ON_START=true
# Log a dependency report (database, Redis, SMTP, AI, SSO...) when each process starts.
STARTUP_DIAGNOSTICS_ENABLED=true
# Include one tiny real AI request in that report (a few tokens) to prove the key/model work.
DIAGNOSTICS_LLM_CALLS=true
